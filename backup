const { default: makeWASocket, useMultiFileAuthState, isJidGroup, fetchLatestBaileysVersion, DisconnectReason } = require('@whiskeysockets/baileys');
const pino = require('pino');
const readline = require('readline');
const fs = require('fs'); 
// 🤫 SILENCIADOR DE LIXO CRIPTOGRÁFICO
const consoleLogOriginal = console.log;
const consoleInfoOriginal = console.info;
console.log = function (...args) {
    if (typeof args[0] === 'string' && args[0].includes('Closing session: SessionEntry')) return;
    consoleLogOriginal.apply(console, args);
};
console.info = function (...args) {
    if (typeof args[0] === 'string' && args[0].includes('Closing session: SessionEntry')) return;
    consoleInfoOriginal.apply(console, args);
};

process.on('uncaughtException', err => console.error('\n[💀 ERRO FATAL]', err));
process.on('unhandledRejection', err => console.error('\n[💀 REJEIÇÃO]', err));

const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
const question = (text) => new Promise((resolve) => rl.question(text, resolve));

// =================================================================
// ⚙️ PAINEL DE CONTROLE
// =================================================================
const WHITELIST_REMETENTES = [
    '5516994338228', 
    '5516993436558',
    '5516992027254'
];
const QTD_ESPIOES = 1; 

const ARQUIVO_BLACKLIST = './blacklist_aegis.json';
const ultimasAmeacas = new Set(); 
const cacheGrupos = {}; 
const pendingMetadata = {}; 

function carregarBlacklist() {
    if (!fs.existsSync(ARQUIVO_BLACKLIST)) fs.writeFileSync(ARQUIVO_BLACKLIST, JSON.stringify([])); 
    return JSON.parse(fs.readFileSync(ARQUIVO_BLACKLIST));
}

function normalizarID(jid) {
    if (!jid) return "";
    let num = String(jid).split('@')[0].split(':')[0].replace(/\D/g, ''); 
    if (num.startsWith('55')) num = num.substring(2); 
    if (num.length === 11 && num[2] === '9') num = num.substring(0, 2) + num.substring(3); 
    return num; 
}

function adicionarNaBlacklist(jid) {
    const lista = carregarBlacklist();
    const idNorm = normalizarID(jid);
    let atualizou = false;

    if (!lista.includes(jid)) { lista.push(jid); atualizou = true; }
    if (idNorm && !lista.includes(idNorm)) { lista.push(idNorm); atualizou = true; }

    if (atualizou) {
        fs.writeFileSync(ARQUIVO_BLACKLIST, JSON.stringify(lista, null, 2));
        console.log(`[💾 BLACKLIST] Invasor cravado no banco de dados com sucesso.`);
    }
}

let sockSniper;
let frotaEspioes = []; 
let codigoSniperSolicitado = false;

// =================================================================
// PASSO 1: INICIAR O SNIPER (NÓ DE ARTILHARIA)
// =================================================================
async function iniciarSniper() {
    const authSniper = await useMultiFileAuthState('auth_sniper');
    let numeroSniper = "";

    if (!authSniper.state.creds.registered) {
        numeroSniper = await question('\n[?] NOVO LOGIN. Digite o NÚMERO DO ADMIN (Com 55! Ex: 5516999999999): ');
        numeroSniper = numeroSniper.replace(/\D/g, '');
    }
    return new Promise((resolve) => conectarSniperNode(numeroSniper, authSniper, resolve));
}

async function conectarSniperNode(numeroSniper, authSniper, resolve) {
    const { version } = await fetchLatestBaileysVersion();
    sockSniper = makeWASocket({
        version, auth: authSniper.state, printQRInTerminal: false, logger: pino({ level: 'silent' }), browser: ['Mac OS', 'Chrome', '121.0.0.0'], markOnlineOnConnect: true
    });
    sockSniper.ev.on('creds.update', authSniper.saveCreds);
    
    sockSniper.ev.on('connection.update', async (update) => {
        const { connection, lastDisconnect, qr } = update;
        if (connection === 'close' && lastDisconnect?.error?.output?.statusCode !== DisconnectReason.loggedOut) {
            conectarSniperNode(numeroSniper, authSniper, resolve); 
        }
        if (qr && !sockSniper.authState.creds.registered && !codigoSniperSolicitado) {
            codigoSniperSolicitado = true;
            try { const code = await sockSniper.requestPairingCode(numeroSniper); console.log(`\n[🔑] CÓDIGO DO SNIPER: ${code}`); } catch (err) {}
        }
        if (connection === 'open') {
            console.log('[✅] Sniper Online.'); resolve(); 
        }
    });

    // =================================================================
    // 🛑 CATRACA DE FERRO V4: Deep Scan + Blindagem de Tipagem
    // =================================================================
    sockSniper.ev.on('group-participants.update', async (evento) => {
        if (evento.action === 'add') {
            const blacklist = carregarBlacklist();
            console.log(`\n[🚪 MONITORAMENTO] Movimento detectado na porta!`);
            
            for (let novato of evento.participants) {
                
                // 🛡️ MÓDULO DE BLINDAGEM DE TIPO (Resolve o erro do .split)
                // Se a Meta mandar um objeto maluco, nós extraímos o ID à força
                if (typeof novato === 'object' && novato !== null) {
                    novato = novato.id || novato.jid || "";
                }
                if (!novato) continue;
                novato = String(novato); // Força a variável a se comportar como Texto (String)

                const idNorm = normalizarID(novato);
                const numPuro = novato.split('@')[0].split(':')[0]; 
                
                console.log(` 🔎 Escaneando ID WhatsAPP: ${numPuro}...`);

                const ehInimigo = blacklist.some(b => {
                    return b === novato || 
                           b.includes(numPuro) || 
                           normalizarID(b) === idNorm;
                });

                if (ehInimigo) {
                    console.log(`[🛑 ALERTA] Invasor da Blacklist reconhecido! Preparando guilhotina...`);
                    
                    setTimeout(async () => {
                        try {
                            await sockSniper.groupParticipantsUpdate(evento.id, [novato], "remove");
                            console.log(`[✅ EJETADO] Invasor chutado para fora da porta com sucesso.`);
                        } catch (err) {
                            console.error(`[❌ FALHA] Erro ao ejetar na porta. O Sniper é Admin neste grupo?`);
                        }
                    }, 1500); 

                } else {
                    console.log(` 🟩 Acesso Liberado para visitante.`);
                }
            }
        }
    });
}

